# AAVYA – HeredityAI Environment Configuration
ENVIRONMENT=development
SECRET_KEY=aavya-super-secret-key-replace-in-production-2026
API_V1_STR=/api/v1

# NeonDB PostgreSQL Connection String
# Replace with your actual NeonDB connection string from your Neon console (https://console.neon.tech):
# Format: postgresql://<user>:<password>@<endpoint-hostname>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
